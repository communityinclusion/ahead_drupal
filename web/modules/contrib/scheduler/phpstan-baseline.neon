# ------------------------------------------------------------------------------
# This phpstan-baseline.neon file contains the messages for code that will
# not be changed. This is a permanent list of ignored messages.
# ------------------------------------------------------------------------------
parameters:
  ignoreErrors:

    #---------------------------------------------------------------------------------------------------------------------------
    # rules_defaults.inc is still 7.x, not converted to 8.x+ and may never be, as development on the Rules project has slowed.
    #---------------------------------------------------------------------------------------------------------------------------
    -
      message: "#^Function rule not found\\.$#"
      count: 4
      path: scheduler_rules_integration/scheduler_rules_integration.rules_defaults.inc

    -
      message: "#^Function rules_condition not found\\.$#"
      count: 2
      path: scheduler_rules_integration/scheduler_rules_integration.rules_defaults.inc

    -
      message: "#^Function rules_reaction_rule not found\\.$#"
      count: 2
      path: scheduler_rules_integration/scheduler_rules_integration.rules_defaults.inc

    #---------------------------------------------------------------------------------------------------------------------------
    # scheduler_form_pane was added for ctools in 7.x, probably does not work in 8.x+
    #---------------------------------------------------------------------------------------------------------------------------
    -
      message: "#^Instantiated class ctools_context_required not found\\.$#"
      count: 1
      path: plugins/content_types/scheduler_form_pane.inc

    #---------------------------------------------------------------------------------------------------------------------------
    # Mapping callback for the Feeds module is still no ported to Drupal 8.
    #---------------------------------------------------------------------------------------------------------------------------
    -
      message: "#^Instantiated class FeedsValidationException not found\\.$#"
      count: 1
      path: scheduler.module

    #---------------------------------------------------------------------------------------------------------------------------
    # The scheduler.drush.inc file is retained for backwards compatibility with Drush 8 and Core versions up to 8.4
    #---------------------------------------------------------------------------------------------------------------------------
    -
      message: "#^Function drush_get_option not found\\.$#"
      count: 1
      path: scheduler.drush.inc

    #---------------------------------------------------------------------------------------------------------------------------
    # The functions node_access_rebuild() and node_access_needs_rebuild() are replaced by a service in Drupal 11.4 but we need
    # to use them in the earlier core versions. This warning is not produced in 11.3 so needs reportUnmatched: false
    # https://www.drupal.org/project/scheduler/issues/3588037
    #---------------------------------------------------------------------------------------------------------------------------
    -
      message: '#^Call to deprecated function node_access(_needs)?_rebuild\(\)#'
      identifier: function.deprecated
      paths:
        - tests/modules/scheduler_access_test/scheduler_access_test.install
        - tests/src/Functional/SchedulerNodeAccessTest.php
      reportUnmatched: false
